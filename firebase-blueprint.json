{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Store configuration and products",
      "type": "object",
      "properties": {
        "n": { "type": "string", "description": "Store Name" },
        "w": { "type": "string", "description": "WhatsApp Number" },
        "a": { "type": "string", "description": "Address" },
        "ig": { "type": "string", "description": "Instagram Username" },
        "fb": { "type": "string", "description": "Facebook URL" },
        "ws": { "type": "string", "description": "Website URL" },
        "c": { "type": "string", "description": "Primary Color (Hex without #)" },
        "b": { "type": "string", "description": "Secondary Color (Hex without #)" },
        "bi": { "type": "string", "description": "Banner Image URL" },
        "t": { "type": "string", "description": "Niche/Type" },
        "imf": { "type": "string", "enum": ["vertical", "quadrado"], "description": "Product Image Format" },
        "lg": { "type": "string", "description": "Store Logo URL" },
        "px": { "type": "string", "description": "PIX Key" },
        "oh": { "type": "object", "description": "Operating Hours Configuration" },
        "cn": { "type": "string", "description": "Owner Contact Name" },
        "bm": { "type": "boolean", "description": "Bar Mode Enabled" },
        "tr": { "type": "integer", "description": "Table Range (Max number of tables)" },
        "ts": { "type": "object", "description": "Table Statuses (tableId: status)" },
        "plan": { "type": "string", "enum": ["free", "basic", "premium"], "description": "Subscription plan" },
        "v": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Vendor Name" },
              "code": { "type": "string", "description": "Unique vendor referral code" },
              "clicks": { "type": "integer", "description": "Number of clicks on the vendor link" }
            }
          }
        },
        "sh": {
          "type": "array",
          "description": "Shipping/Delivery Zones",
          "items": {
            "type": "object",
            "properties": {
              "neighborhood": { "type": "string" },
              "price": { "type": "string" }
            }
          }
        },
        "status": { "type": "string", "enum": ["trial", "active", "blocked"], "description": "Subscription status" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Expiration date" },
        "p": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "Product Unique ID" },
              "n": { "type": "string", "description": "Product Name" },
              "p": { "type": "string", "description": "Product Price" },
              "wp": { "type": "string", "description": "Wholesale Price" },
              "wq": { "type": "string", "description": "Wholesale Min Quantity" },
              "i": { "type": "string", "description": "Product Image URL" },
              "i2": { "type": "string", "description": "Additional Image URL 2" },
              "i3": { "type": "string", "description": "Additional Image URL 3" },
              "i4": { "type": "string", "description": "Additional Image URL 4" },
              "v": { "type": "string", "description": "Optional Product Video URL" },
              "cat": { "type": "string", "description": "Category" },
              "d": { "type": "string", "description": "Description" },
              "av": { "type": "boolean", "description": "Is product available?" },
              "vars": { "type": "string", "description": "Variations (comma separated)" },
              "f": { "type": "boolean", "description": "Is product featured?" },
              "al": { "type": "string", "description": "Affiliate link" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "clicks": { "type": "integer", "description": "Total store page views/clicks" },
        "password": { "type": "string", "description": "Editing password chosen by the owner" },
        "gameActive": { "type": "boolean", "description": "Whether gamification attraction is active on store" },
        "gameType": { "type": "string", "enum": ["native", "iframe"], "description": "Gamification mode: native games or external iframe" },
        "gameUrl": { "type": "string", "description": "External iframe URL if gameType is iframe" },
        "nativeGame": { "type": "string", "enum": ["roulette", "scratch", "mystery", "slots", "all"], "description": "Primary native game featured" },
        "gameSound": { "type": "boolean", "description": "Enable sound effects" },
        "gameAutoPopup": { "type": "boolean", "description": "Open game automatically on store visit" },
        "gameMinOrderValue": { "type": "number", "description": "Minimum cart order value in R$ to unlock the game" },
        "gamePrizes": {
          "type": "array",
          "description": "List of custom prize items configured for native games",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Prize display name" },
              "percent": { "type": "number", "description": "Percentage discount" },
              "fixed": { "type": "number", "description": "Fixed discount in R$" },
              "code": { "type": "string", "description": "Coupon code" },
              "color": { "type": "string", "description": "Sector hex color" }
            }
          }
        }
      },
      "required": ["n", "w", "password"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order submitted from catalog",
      "type": "object",
      "properties": {
        "storeSlug": { "type": "string", "description": "Store slug or id" },
        "storeWhatsapp": { "type": "string", "description": "Store WhatsApp phone" },
        "orderNumber": { "type": "string", "description": "Order number code like #1042" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerPhone": { "type": "string", "description": "Customer phone" },
        "customerAddress": { "type": "string", "description": "Delivery address or pickup notice" },
        "shippingType": { "type": "string", "enum": ["delivery", "pickup"], "description": "Delivery or pickup" },
        "shippingNeighborhood": { "type": "string", "description": "Neighborhood for delivery" },
        "shippingFee": { "type": "number", "description": "Delivery fee" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "integer" },
              "price": { "type": "string" },
              "variations": { "type": "object" },
              "observation": { "type": "string" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "discountDesc": { "type": "string" },
        "cardFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["pix", "cash", "card"] },
        "cashChange": { "type": "string" },
        "installments": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "preparing", "ready", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "timestamp": { "type": "integer" }
      },
      "required": ["storeSlug", "items", "total", "status"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Public store data"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store orders collection"
    },
    "/stores/{storeId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Store subcollection orders"
    }
  }
}
