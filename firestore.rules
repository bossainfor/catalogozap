rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidStore(data) {
      return data.n is string && data.n.size() > 0 && data.n.size() < 100 &&
             data.w is string && data.w.size() > 0 && data.w.size() < 20 &&
             data.status in ['trial', 'active', 'blocked'] &&
             data.expiresAt is string;
    }

    match /stores/{storeId} {
      // Allow anyone to read, create, update and delete a store
      allow read, write: if true;
    }

    match /stores/{storeId}/{document=**} {
      // Allow subcollections under stores (like catalog_chunks, reviews)
      allow read, write: if true;
    }

    // Allow anyone to read and write reviews in a flat collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Allow anyone to read and write nested reviews explicitly
    match /stores/{storeId}/reviews/{reviewId} {
      allow read, write: if true;
    }

    match /trial_history/{whatsapp} {
      // Allow all operations on trial history
      allow read, write: if true;
    }

    // Allow anyone to read and write orders for the store
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /stores/{storeId}/orders/{orderId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;
    }

    match /stores/{storeId}/chats/{chatId} {
      allow read, write: if true;
    }

    match /promotions/{promoId} {
      allow read, write: if true;
    }

    match /stores/{storeId}/promotions/{promoId} {
      allow read, write: if true;
    }

    match /resellers/{resellerId} {
      // Allow all operations on resellers
      allow read, write: if true;
    }

    match /configs/{configId} {
      // Allow all operations on global configs
      allow read, write: if true;
    }

    match /configs/global {
      allow read, write: if true;
    }

    match /configs/{document=**} {
      allow read, write: if true;
    }
  }
}
